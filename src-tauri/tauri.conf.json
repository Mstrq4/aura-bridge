{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AuraBridge",
  "version": "2.1.0",
  "identifier": "com.mstrq4.aurabridge",
  "mainBinaryName": "claude-switch-pro",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "AuraBridge — Universal AI Responses Control Center",
        "width": 1360,
        "height": 880,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "backgroundColor": "#faf7f5",
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEwMkE4ODU5QTExMEU3QjkKUldTNTV4Q2hXWWdxRVBDUm1NK2FyZTZMRVcrRjJDOG9lUXgvVW1TVjU3azBxQmFzcEV6ZXUrWEgK",
      "endpoints": [
        "https://github.com/Mstrq4/aura-bridge/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}

